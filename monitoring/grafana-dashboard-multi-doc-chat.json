{
  "dashboard": {
    "title": "MultiDocChat Monitoring",
    "tags": ["multi-doc-chat", "fastapi"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Pod CPU Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{pod=~\"multi-doc-chat.*\"}[5m])",
            "legendFormat": "{{pod}}"
          }
        ]
      },
      {
        "title": "Pod Memory Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "container_memory_usage_bytes{pod=~\"multi-doc-chat.*\"} / 1024 / 1024",
            "legendFormat": "{{pod}} (MB)"
          }
        ]
      },
      {
        "title": "HTTP Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(app_requests_total[5m])",
            "legendFormat": "Requests/sec"
          }
        ]
      },
      {
        "title": "Pod Restarts",
        "type": "singlestat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "kube_pod_container_status_restarts_total{pod=~\"multi-doc-chat.*\"}"
          }
        ]
      }
    ]
  }
}
